# Mandat configuration. Copy to .env and fill in; .env is gitignored. Never commit real keys.

# HTTP port (default 8790)
PORT=
# Public https base URL when hosted (PayPal return URLs, invoice links). Default: http://localhost:$PORT
PUBLIC_URL=

# PayPal SANDBOX app keys (developer.paypal.com). Enable "Save payment methods" and "Invoicing" on the app.
# Leave empty to run in the clearly labelled offline demo mode (no PayPal calls).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Nebius Token Factory API key (required: the agent cannot answer without it). tokenfactory.nebius.com
NEBIUS_API_KEY=
# Optional overrides (defaults shown): any OpenAI-compatible endpoint and model names work
# LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
# LLM_FAST_MODEL=nvidia/nemotron-3-super-120b-a12b     # the agent, merchant agents, titles
# LLM_SMART_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b    # plan review, and fallback when a call fails
# LLM_VISION_MODEL=google/gemma-3-27b-it               # photos
# Demo merchants without an AI agent: answer speed (1 = 20 to 50 s, 0.4 = 8 to 20 s)
MANDAT_MERCHANT_DELAY=
# Ceiling for the model bill in USD (empty: none). Past it, the agent pauses with a clear message (lib/spend.mjs).
MANDAT_LLM_BUDGET_USD=

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
# If empty, a key pair is generated once and saved to a private 600-mode file.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:hello@mandat.app
VAPID_SUBJECT=

# Data directory for users, missions and the OpenStreetMap cache (default ./data)
MANDAT_DATA=
# Public-demo guards (defaults shown in README): daily AI allowance and per-IP write limit
MANDAT_TURNS_PER_USER_DAY=
MANDAT_MISSIONS_PER_USER_DAY=
MANDAT_TURNS_PER_DAY=
MANDAT_WRITES_PER_MINUTE=

# Optional: Google Places (New) key for real place photos and ratings; daily cap keeps it in the free tier
GOOGLE_PLACES_KEY=
MANDAT_GOOGLE_PREVIEWS_PER_DAY=
# PayPal environment: sandbox (default) or production
PAYPAL_ENV=

# Optional: Channel3 key for real product search and shopping (developers.trychannel3.com)
CHANNEL3_API_KEY=
MANDAT_SHOP_SEARCHES_PER_USER_DAY=
MANDAT_SHOP_SEARCHES_PER_DAY=

# Optional: AG Studio licence key (the Activity dashboard runs without it, with a watermark)
AG_STUDIO_LICENSE_KEY=
MANDAT_STUDIO_TURNS_PER_USER_DAY=
MANDAT_STUDIO_TURNS_PER_DAY=

# Optional: keep data/ in a Cloudflare R2 bucket across restarts (needed on hosts with an ephemeral disk)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
